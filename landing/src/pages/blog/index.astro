---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const title = 'Blog';
const description = 'Notes on journaling, reflection, and building a daily spiritual habit.';
---

<Base title={title} description={description}>
  <section class="py-12 sm:py-16 px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-4xl sm:text-5xl font-bold text-gray-900 mb-3">Blog</h1>
      <p class="text-lg text-gray-600 mb-12">Notes on journaling, reflection, and building a daily spiritual habit.</p>

      {posts.length === 0 && (
        <p class="text-gray-500">No posts yet — check back soon.</p>
      )}

      <div class="space-y-8">
        {posts.map((post) => (
          <a href={`/blog/${post.id}`} class="block group">
            <article class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-gray-100 transition group-hover:shadow-md">
              <time class="text-sm text-gray-500" datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
              <h2 class="text-2xl font-semibold text-gray-900 mt-2 group-hover:text-brand transition">
                {post.data.title}
              </h2>
              <p class="text-gray-600 mt-2">{post.data.description}</p>
            </article>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
