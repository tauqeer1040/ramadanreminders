{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meowmin",
  "compatibility_date": "2026-05-03",
  "compatibility_flags": ["nodejs_compat", "enable_nodejs_http_modules", "enable_nodejs_http_server_modules"],
  "no_bundle": true,
  "pages_build_output_dir": "public",
  "limits": {
    "subrequest_limit": 1000
  },
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:3000,http://localhost:3007,https://meowmin.netlify.app,https://meowmin.taucity.xyz,https://meowmin.pages.dev",
    "PORT": "3007"
  }
}
