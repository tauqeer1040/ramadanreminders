default_platform(:android)

platform :android do
  desc "Upload store listing metadata (no build) to Play Console internal draft"
  lane :metadata do
    supply(
      track: "internal",
      release_status: "draft",
      metadata_path: "fastlane/metadata/android",
      skip_upload_aab: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      check_superseded_tracks: true
    )
  end

  desc "Build AAB + upload metadata + AAB to Play Console internal draft"
  lane :deploy do
    gradle(task: "bundleRelease", project_dir: "android/")
    supply(
      track: "internal",
      release_status: "draft",
      metadata_path: "fastlane/metadata/android",
      aab: "android/build/app/outputs/bundle/release/app-release.aab",
      skip_upload_images: true,
      skip_upload_screenshots: true,
      check_superseded_tracks: true
    )
  end
end
