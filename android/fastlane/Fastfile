default_platform(:android)

# Resolve the repo root from this file rather than the current directory, so
# every path works whether fastlane is invoked from android/ or the root.
REPO_ROOT = File.expand_path("../..", __dir__)
AAB_PATH = File.join(REPO_ROOT, "build/app/outputs/bundle/release/app-release.aab")
METADATA_PATH = File.join(REPO_ROOT, "android/fastlane/metadata/android")

platform :android do
  desc "Upload store listing metadata (no build) to Play Console internal draft"
  lane :metadata do
    supply(
      track: "internal",
      release_status: "draft",
      metadata_path: METADATA_PATH,
      skip_upload_aab: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      check_superseded_tracks: true
    )
  end

  desc "Build AAB + upload metadata + AAB to Play Console internal draft"
  lane :deploy do
    gradle(task: "bundleRelease", project_dir: "android/")
    supply(
      track: "internal",
      release_status: "draft",
      metadata_path: METADATA_PATH,
      aab: AAB_PATH,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      check_superseded_tracks: true
    )
  end

  desc "Build the release AAB and ship it to the Play production track (full rollout)"
  lane :prod do
    # Version comes from pubspec.yaml (versionName+buildNumber); bump the
    # build number before running — Play rejects a reused versionCode.
    sh("cd #{REPO_ROOT} && flutter build appbundle --release")
    supply(
      aab: AAB_PATH,
      track: "production",
      release_status: "completed",
      # The live listing is managed in Play Console; uploading the local
      # metadata folder would overwrite it. Use the `metadata` lane when the
      # listing itself is meant to change.
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      check_superseded_tracks: true
    )
  end

  desc "Build the release AAB and ship it to the Play production track as a staged rollout (default 20%)"
  lane :prod_staged do |options|
    user_fraction = (options[:fraction] || 0.2).to_f
    sh("cd #{REPO_ROOT} && flutter build appbundle --release")
    supply(
      aab: AAB_PATH,
      track: "production",
      release_status: "inProgress",
      rollout: user_fraction,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      check_superseded_tracks: true
    )
  end
end
