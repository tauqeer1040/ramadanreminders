PORT_V2=3007
PORT=4000

# --- RevenueCat + Paddle (LIVE) ---
# Live RevenueCat REST API secret (for /v1/subscribers verification).
# Get from RevenueCat dashboard > Project Settings > API Keys (live, not sandbox).
# Project ID: projd48bfa0c — App: "Meowmin Web Paddle" (app0b77e301af)
# Leave empty to skip server-side verification (client-trusted sync only — not recommended for live).
REVENUECAT_API_SECRET=

# Live Paddle API key (vendors.paddle.com, NOT sandbox-vendors).
# PDL live keys start with pdl_live_apikey_ — sandbox keys (pdl_sdbx_) will NOT work in live.
# Paddle sandbox was set up under RC app app0b77e301af ("Meowmin Web Paddle").
# Created live client token (2026-09-02): live_5cb906ee26aa4f9fb9f0c9d52e7 (store in PADDLE_CLIENT_TOKEN below)
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=live_...

# Paddle webhook notification secret for signature verification.
# Get from Paddle dashboard > Developer Tools > Notifications > the destination's endpoint_secret_key.
# Live DB webhook created (2026-09-02): ntfset_01m1hx6k44zrx9xvpzfxkwhtdx -> https://meowmin.taucity.xyz/api/paddle-webhook
# Its secret was shown once: pdl_ntfset_... Save it to PADDLE_NOTIFICATION_WEBHOOK_SECRET immediately (you cannot fetch it again).
PADDLE_NOTIFICATION_WEBHOOK_SECRET=

# Comma-separated list of origins allowed to call the API (CORS).
# Include the current app origin plus the landing page and company page.
# Example for the web app deployed on Netlify:
#   ALLOWED_ORIGINS=https://meowmin.taucity.xyz,https://taucity.xyz,https://<your-netlify-app>.netlify.app
ALLOWED_ORIGINS=https://meowmin.taucity.xyz,https://taucity.xyz

OPENROUTER_API_KEY=your_openrouter_api_key_here
FANAR_BASE_URL=https://api.fanar.qa
FANAR_API_KEY=your_fanar_api_key_here
FANAR_MODEL=Fanar
AI_INITIAL_DELAY_HOURS=12
AI_POLL_INTERVAL_MS=60000

# Encryption: generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JOURNAL_ENCRYPTION_SECRET=your_64_char_hex_encryption_secret_here

# --- Email continuation (Resend) ---
# API key from resend.com. If empty, emails are logged, never sent.
RESEND_API_KEY=
# Verified sender identity, e.g. Meowmin <hello@meowmin.taucity.xyz>
EMAIL_FROM=Meowmin <hello@meowmin.taucity.xyz>
# Public web origin used to build personalized pricing links.
PUBLIC_WEB_URL=https://meowmin.taucity.xyz

# --- Google Play External Offers (EEA) ---
# Path to the Play Console service-account JSON (needs financial/monetary perms
# for the External Transactions API). Defaults to the repo-local key.
GOOGLE_PLAY_SERVICE_ACCOUNT_PATH=../android/fastlane/play-developer-api.json
# Android package the external transactions are reported under.
GOOGLE_PLAY_PACKAGE_NAME=com.taucity.meowmin
# Kill-switch + server-driven launch mode for the Android link-out.
EXTERNAL_OFFERS_ENABLED=true
EXTERNAL_OFFER_LAUNCH_MODE=external_browser
