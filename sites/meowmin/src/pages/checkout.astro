---
import Base from '../layouts/Base.astro';
Astro.response.status = 404;
Astro.response.headers.set('X-Robots-Tag', 'noindex');
const title = 'Page moved';
const description = 'Checkout has moved to Pricing.';
---

<Base title={title} description={description} noindex={true}>
  <section class="py-16 px-6 lg:px-8">
    <div class="max-w-xl mx-auto text-center">
      <h1 class="text-3xl font-bold text-gray-900">Checkout moved to Pricing</h1>
      <p class="text-gray-500 mt-3">We’ve consolidated checkout into <a href="/pricing" class="text-brand underline">Pricing</a>. Use the buttons there to pay — they open Paddle directly.</p>
      <a href="/pricing" class="mt-6 inline-flex bg-brand text-white px-6 py-3 rounded-2xl font-semibold hover:bg-brand-dark transition">Go to Pricing →</a>
    </div>
  </section>
</Base>
